-o
/bin/genpeep
-DHAVE_CONFIG_H
-DGENERATOR_FILE
-DUSE_C_ALLOCA
-I
/src/gcc
-I
/src/gcc/include
-I
/src/gcc/libiberty
-I
/include
-nostdlib
-Wl,-Ttext=0x10000
-Wl,-oformat=elf64-little
/lib/crt.s
/lib/libc.c
/src/gcc/c-alloca.c
/src/gcc/libiberty/xmalloc.c
/src/gcc/libiberty/xstrdup.c
/src/gcc/libiberty/xexit.c
/src/gcc/libiberty/obstack.c
/src/gcc/libiberty/safe-ctype.c
/src/gcc/mini-htab.c
/src/gcc/iberty-misc.c
/src/gcc/errors.c
/src/gcc/ggc-none.c
/src/gcc/dummy-conditions.c
/src/gcc/min-insn-modes.c
/src/gcc/rtl.c
/src/gcc/read-rtl.c
/src/gcc/gensupport.c
/src/gcc/print-rtl.c
/src/gcc/genpeep.c
