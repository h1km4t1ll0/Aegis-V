-o
/bin/gencheck
-DHAVE_CONFIG_H
-DGENERATOR_FILE
-DUSE_C_ALLOCA
-I
/src/gcc
-I
/src/gcc/include
-I
/src/gcc/libiberty
-I
/include
-nostdlib
-Wl,-Ttext=0x10000
-Wl,-oformat=elf64-little
/lib/crt.s
/lib/libc.c
/src/gcc/c-alloca.c
/src/gcc/libiberty/xmalloc.c
/src/gcc/libiberty/xstrdup.c
/src/gcc/libiberty/xexit.c
/src/gcc/gencheck.c
