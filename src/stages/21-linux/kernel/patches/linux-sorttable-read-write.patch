+/* Use a private writable copy; keep sorting independent of file mmap. */
+static void *read_file(char const *fname, size_t *size)
+{
+    int fd = open(fname, O_RDONLY);
+    struct stat st;
+    char *buf = NULL;
+    size_t off = 0;
+    if (fd < 0)
+        goto fail;
+    if (fstat(fd, &st) < 0)
+        goto fail;
+    if (!S_ISREG(st.st_mode) || st.st_size <= 0) {
+        errno = EINVAL;
+        goto fail;
+    }
+    buf = malloc(st.st_size);
+    if (!buf)
+        goto fail;
+    while (off < (size_t)st.st_size) {
+        ssize_t n = read(fd, buf + off, st.st_size - off);
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n <= 0) {
+            if (!n)
+                errno = EIO;
+            goto fail;
+        }
+        off += n;
+    }
+    close(fd);
+    *size = st.st_size;
+    return buf;
+fail:
+    perror(fname);
+    if (fd >= 0)
+        close(fd);
+    free(buf);
+    return NULL;
+}
+
+static int write_file(char const *fname, const void *buf, size_t size)
+{
+    int fd = open(fname, O_WRONLY);
+    size_t off = 0;
+    if (fd < 0)
+        goto fail;
+    while (off < size) {
+        ssize_t n = write(fd, (const char *)buf + off, size - off);
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n <= 0) {
+            if (!n)
+                errno = EIO;
+            goto fail;
+        }
+        off += n;
+    }
+    if (close(fd) == 0)
+        return 0;
+    fd = -1;
+fail:
+    perror(fname);
+    if (fd >= 0)
+        close(fd);
+    return -1;
 }
 
